{
    "name": "modrinth-scout",
    "version": "1.1.8",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc && node --eval \"const{cpSync}=require('node:fs');cpSync('src/assets','dist/assets',{recursive:true})\"",
        "start": "node dist/index.js",
        "lint": "eslint src/ tests/",
        "lint:fix": "eslint src/ tests/ --fix",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "scripts": "node scripts/run.mjs",
        "release:patch": "pnpm version patch && git push && git push --tags",
        "release:minor": "pnpm version minor && git push && git push --tags",
        "release:major": "pnpm version major && git push && git push --tags"
    },
    "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
    "dependencies": {
        "@modrinth/api-client": "^0.27.0",
        "discord.js": "^14.26.4",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "mongoose": "^9.7.4",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.1.3",
        "prom-client": "^15.1.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@resvg/resvg-js": "^2.6.2",
        "@types/express": "^5.0.6",
        "@types/node": "^26.1.1",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^10.6.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "prettier": "^3.9.4",
        "tsx": "^4.23.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.63.0",
        "vitest": "^4.1.10"
    }
}
