{
    "name": "modrinth-scout",
    "version": "1.2.4",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc && node --eval \"const{cpSync}=require('node:fs');cpSync('src/assets','dist/assets',{recursive:true})\"",
        "start": "node dist/index.js",
        "lint": "eslint src/ tests/",
        "lint:fix": "eslint src/ tests/ --fix",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "scripts": "node scripts/run.mjs",
        "release:patch": "pnpm version patch && git push && git push --tags",
        "release:minor": "pnpm version minor && git push && git push --tags",
        "release:major": "pnpm version major && git push && git push --tags"
    },
    "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25",
    "dependencies": {
        "@modrinth/api-client": "^0.33.0",
        "@openrouter/sdk": "^0.13.67",
        "discord.js": "^14.27.0",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "mongoose": "^9.7.4",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.1.3",
        "prom-client": "^15.1.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@resvg/resvg-js": "^2.6.2",
        "@types/express": "^5.0.6",
        "@types/node": "^26.1.1",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "prettier": "^3.9.5",
        "tsx": "^4.23.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.64.0",
        "vitest": "^4.1.10"
    }
}
