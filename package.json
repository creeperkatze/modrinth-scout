{
    "name": "modrinth-scout",
    "version": "1.3.7",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc && node --eval \"const{cpSync}=require('node:fs');cpSync('src/assets','dist/assets',{recursive:true})\"",
        "start": "node dist/index.js",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "scripts": "node scripts/run.mjs",
        "migrate:create": "migrate-mongo create",
        "migrate:up": "migrate-mongo up",
        "migrate:down": "migrate-mongo down",
        "migrate:status": "migrate-mongo status",
        "release": "pnpm version -m \"chore(release): v%s\"",
        "postversion": "git push --follow-tags"
    },
    "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
    "dependencies": {
        "@modrinth/api-client": "^0.110.0",
        "@prometheus-io/client": "^0.16.1",
        "@top-gg/sdk": "^4.0.0",
        "discord.js": "^14.28.1",
        "dotenv": "^18.0.10",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.4",
        "migrate-mongo": "^14.0.7",
        "mongoose": "^9.12.1",
        "pino": "^10.4.0",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.2.0"
    },
    "devDependencies": {
        "@resvg/resvg-js": "^2.6.2",
        "@types/express": "^5.0.6",
        "@types/migrate-mongo": "^14.0.0",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.1.0",
        "mongodb-memory-server": "^11.3.0",
        "oxfmt": "^0.78.0",
        "oxlint": "^1.93.0",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "vitest": "^5.1.0"
    }
}
