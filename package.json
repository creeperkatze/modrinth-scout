{
    "name": "modrinth-scout",
    "version": "1.3.0",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc && node --eval \"const{cpSync}=require('node:fs');cpSync('src/assets','dist/assets',{recursive:true})\"",
        "start": "node dist/index.js",
        "lint": "eslint src/ tests/ website/",
        "lint:fix": "eslint src/ tests/ website/ --fix",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "scripts": "node scripts/run.mjs",
        "migrate:create": "migrate-mongo create",
        "migrate:up": "migrate-mongo up",
        "migrate:down": "migrate-mongo down",
        "migrate:status": "migrate-mongo status",
        "release:patch": "pnpm version patch && git push && git push --tags",
        "release:minor": "pnpm version minor && git push && git push --tags",
        "release:major": "pnpm version major && git push && git push --tags"
    },
    "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
    "dependencies": {
        "@modrinth/api-client": "^0.73.0",
        "@openrouter/sdk": "^1.3.2",
        "@prometheus-io/client": "^0.16.1",
        "@top-gg/sdk": "^4.0.0",
        "discord.js": "^14.27.0",
        "dotenv": "^18.0.1",
        "express": "^5.2.1",
        "migrate-mongo": "^14.0.7",
        "mongoose": "^9.10.1",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.1.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@resvg/resvg-js": "^2.6.2",
        "@types/express": "^5.0.6",
        "@types/migrate-mongo": "^14.0.0",
        "@types/node": "^26.6.2",
        "@vitest/coverage-v8": "^5.0.1",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-vue": "^10.11.0",
        "mongodb-memory-server": "^11.2.0",
        "prettier": "^3.9.8",
        "tsx": "^4.23.13",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vitest": "^5.0.1",
        "vue-eslint-parser": "^10.4.1"
    }
}
